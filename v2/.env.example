DATABASE_URL=postgres://investnexus:investnexus_local@127.0.0.1:55432/investnexus
PORT=4200
# Optional additional trusted origins for a separate deployment frontend.
# TRUSTED_ORIGINS=https://app.example.com
# Cookie Secure must be enabled when deployed behind HTTPS.
COOKIE_SECURE=false
# Optional demo provisioning. Never use the documented demo password in production.
DEMO_PASSWORD=LocalDemo-2026!

# Optional: docker compose --profile messaging up -d
# RABBITMQ_URL=amqp://investnexus:investnexus_local@127.0.0.1:5672

# Daily-close prices; mock is deterministic and requires no credentials.
MARKET_PROVIDER=mock
MOCK_MARKET_START_DATE=2026-09-18
MARKET_POLL_SECONDS=3600
# Set MARKET_PROVIDER=alpha-vantage to use your own daily-close feed.
# ALPHA_VANTAGE_API_KEY=
# Optional display cache. Financial valuations always read PostgreSQL.
# REDIS_URL=redis://127.0.0.1:56379
